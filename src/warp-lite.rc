// Icono y datos del programa (también los usa el instalador). El Administrador de tareas
// muestra FileDescription como nombre.
#include <winver.h>

1 ICON "assets/warp-lite.ico"

1 VERSIONINFO
FILEVERSION 0,3,2,0
PRODUCTVERSION 0,3,2,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "justdiego"
      VALUE "FileDescription", "Warp"
      VALUE "ProductName", "Warp"
      VALUE "OriginalFilename", "Warp.exe"
      VALUE "FileVersion", "0.3.2"
      VALUE "ProductVersion", "0.3.2"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
